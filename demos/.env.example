# Copy this file to .env and fill in what you have.
# .env is gitignored, so keys never reach GitHub.

# ---- Demo 3: voice agent brain -------------------------------------------
# Optional. Without it the agent falls back to a scripted host and still runs.
# Get one at https://console.anthropic.com
ANTHROPIC_API_KEY=

# Model and effort. Leave as-is unless you want to trade cost for depth.
ARIA_MODEL=claude-opus-5
ARIA_EFFORT=

# City name, for the voice agent's small talk: it looks up the local time and
# the current weather (Open-Meteo, no key). Leave blank and it uses the clock
# only. There is no IP geolocation fallback on purpose.
ARIA_LOCATION=low

# ---- Demo 3: local engines ------------------------------------------------
# tiny.en is fastest, base.en is the default, small.en is most accurate.
WHISPER_MODEL=base.en
# Path to a Piper .onnx voice. Blank = auto-discover in 03_voice_agent/voices/
PIPER_VOICE=

# ---- Demo 5: OCR ----------------------------------------------------------
# tesseract (default) or paddle.
#   tesseract  word-level boxes with true coordinates. Required for the
#              layout and table work: all 8 corpus tables correct.
#   paddle     better character accuracy but line-level detection with
#              normalised spacing, so column gaps are lost. 4 tables, 2 bad.
OCR_ENGINE=tesseract
# Only needed if tesseract.exe is not on PATH.
TESSERACT_CMD=

# ---- Demo 2: web automation ----------------------------------------------
# Leave blank to run with a visible browser, which is what you want on camera.
HEADLESS=

# Gemini, as an alternative brain. With this set the voice agent prefers it:
# gemini-2.5-flash reaches its first token in about 0.8 to 1.2s on a
# laptop, a little ahead of claude-haiku-4-5. ARIA_PROVIDER=claude forces
# the other way, GEMINI_MODEL picks a different one.
GOOGLE_API_KEY=
ARIA_PROVIDER=
GEMINI_MODEL=
